# Database Configuration
POSTGRES_USER=coffee_admin
POSTGRES_PASSWORD=coffee_password_123
POSTGRES_DB=coffee_shop
POSTGRES_PORT=5432

# Backend Configuration
DATABASE_URL=postgresql://coffee_admin:coffee_password_123@db:5432/coffee_shop
TEST_DATABASE_URL=sqlite:///./test.sqlite
TESTING=false

# Security & JWT
SECRET_KEY=replace_with_a_super_secret_jwt_key_at_least_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Email Service (SMTP)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=Coffee Shop API

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost,http://127.0.0.1:5173

# Frontend (Vite)
VITE_API_URL=http://localhost:8000